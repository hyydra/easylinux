#!/usr/bin/env python3
"""Keyboard layout indicator for the XFCE Generic Monitor (genmon) panel plugin.

The stock xkb panel plugin hard-codes a bold monospace font and lowercase codes ("hu").
This prints the current layout in capitals ("HU") in the normal panel font, and switches to
the next layout when clicked.
    easylinux-layout [PLUGIN]       genmon output (text, tooltip, click action)
    easylinux-layout next [PLUGIN]  switch to the next layout
PLUGIN is the genmon plugin's name (e.g. genmon-19); with it the indicator redraws at once.
"""
import ctypes
import ctypes.util
import os
import subprocess
import sys

XKB_USE_CORE_KBD = 0x100


class XkbState(ctypes.Structure):
    _fields_ = [("group", ctypes.c_ubyte), ("locked_group", ctypes.c_ubyte),
                ("base_group", ctypes.c_ushort), ("latched_group", ctypes.c_ushort),
                ("mods", ctypes.c_ubyte), ("base_mods", ctypes.c_ubyte),
                ("latched_mods", ctypes.c_ubyte), ("locked_mods", ctypes.c_ubyte),
                ("compat_state", ctypes.c_ubyte), ("grab_mods", ctypes.c_ubyte),
                ("compat_grab_mods", ctypes.c_ubyte), ("lookup_mods", ctypes.c_ubyte),
                ("compat_lookup_mods", ctypes.c_ubyte), ("ptr_buttons", ctypes.c_ushort)]


def layouts():
    out = subprocess.run(["setxkbmap", "-query"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("layout:"):
            return [x.strip() for x in line.split(":", 1)[1].split(",") if x.strip()]
    return []


def main():
    names = layouts()
    x11 = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    display = x11.XOpenDisplay(None)
    if not display or not names:
        print("<txt>?</txt><tool>No X display or no keyboard layouts</tool>")
        return
    state = XkbState()
    x11.XkbGetState(ctypes.c_void_p(display), XKB_USE_CORE_KBD, ctypes.byref(state))
    group = state.group if state.group < len(names) else 0

    args = sys.argv[1:]
    switch = bool(args) and args[0] == "next"
    if switch:
        args = args[1:]
    plugin = args[0] if args else ""

    if switch:
        x11.XkbLockGroup(ctypes.c_void_p(display), XKB_USE_CORE_KBD, (group + 1) % len(names))
        x11.XFlush(ctypes.c_void_p(display))
        if plugin:  # redraw the indicator right away instead of at the next update
            subprocess.run(["xfce4-panel", f"--plugin-event={plugin}:refresh:bool:true"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    code = names[group].upper()
    others = ", ".join(n.upper() for n in names)
    me = os.path.abspath(sys.argv[0])
    print(f"<txt>{code}</txt><tool>Keyboard layout: {code} ({others}) - click to switch</tool>"
          f"<txtclick>{me} next {plugin}</txtclick>")
    x11.XCloseDisplay(ctypes.c_void_p(display))


if __name__ == "__main__":
    main()
