#!/bin/sh
# Keyboard backlight control through UPower (no root needed).
#   up | down | cycle (off -> dim -> bright -> off) | on | off | status
UP="busctl --system call org.freedesktop.UPower /org/freedesktop/UPower/KbdBacklight org.freedesktop.UPower.KbdBacklight"

max=$($UP GetMaxBrightness 2>/dev/null | awk '{print $2}')
cur=$($UP GetBrightness 2>/dev/null | awk '{print $2}')
if [ -z "$max" ] || [ -z "$cur" ]; then
    echo "No keyboard backlight found (UPower KbdBacklight)." >&2
    exit 1
fi

case "${1:-}" in
    up)     new=$((cur + 1)) ;;
    down)   new=$((cur - 1)) ;;
    cycle)  new=$((cur + 1)); [ "$new" -gt "$max" ] && new=0 ;;
    on)     new=$max ;;
    off)    new=0 ;;
    status) echo "$cur/$max"; exit 0 ;;
    *)      echo "Usage: ${0##*/} up|down|cycle|on|off|status" >&2; exit 1 ;;
esac
[ "$new" -gt "$max" ] && new=$max
[ "$new" -lt 0 ] && new=0
$UP SetBrightness i "$new" >/dev/null
